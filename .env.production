# Used automatically by `vite build` (production mode) when no build-time
# environment variable overrides it. Note that a Vercel project's own
# Environment Variables settings OVERRIDE this file - if a value here does
# not seem to take effect, check there first.
VITE_API_BASE_URL=https://rsa-backend-2026.onrender.com/api

# ---------------------------------------------------------------------------
# Both portals need to know BOTH addresses.
#
# This portal uses them to forward a session that does not belong to it on
# to the portal that does, instead of rendering itself with the other
# role's credentials (see src/portalSession.js). Without these set, an
# account that lands on the wrong portal can still be stopped, but it has
# to be sent back to the login screen by hand rather than passed straight
# through to the right place.
#
# These must match the two URLs configured in the mobile app's
# .env.production (VITE_ADMIN_PORTAL_URL / VITE_MANAGER_PORTAL_URL) and the
# hostnames in its capacitor.config.json allowNavigation list.
VITE_ADMIN_PORTAL_URL=https://rsa-admin-frontend.vercel.app
VITE_MANAGER_PORTAL_URL=https://rsa-manager-frontend.vercel.app

# Optional escape hatch. Set to true to restore the old behaviour where any
# authenticated account can open this portal (a manager reaching the Admin
# portal is degraded to the Labour-only experience rather than turned
# away). Leave unset/false to keep the two portals' credentials separate.
# VITE_ALLOW_CROSS_ROLE=false
